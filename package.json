{
	"name": "jiracle",
	"version": "0.0.1",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"dev:watch": "nodemon --watch dist --exec \"node dist/cli.js\"",
		"start": "npm run build && node dist/cli.js",
		"test": "npm run build && prettier --check . && ava",
		"release": "release-it"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@inkjs/ui": "^2.0.0",
		"@types/ms": "^2.1.0",
		"@types/node-notifier": "^8.0.5",
		"figures": "^6.1.0",
		"ink": "^6.0.1",
		"ink-big-text": "^2.0.0",
		"ink-gradient": "^3.0.0",
		"meow": "^11.0.0",
		"ms": "^2.1.3",
		"node-notifier": "^10.0.1",
		"open": "^10.1.2",
		"react": "^19.1.0",
		"winston": "^3.17.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/react": "^19.1.8",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^4.0.0",
		"prettier": "^2.8.7",
		"react-devtools-core": "^4.28.5",
		"release-it": "^19.0.4",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.3",
		"xo": "^0.53.1"
	},
	"ava": {
		"files": [
			"dist/**/*.test.js",
			"dist/*.test.js",
			"dist/tests/**/*.test.js"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config",
	"release-it": {
		"$schema": "https://unpkg.com/release-it/schema/release-it.json",
		"github": {
			"release": true
		}
	}
}
