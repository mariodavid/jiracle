{
	"name": "jiracle",
	"version": "0.0.1",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"dev:watch": "nodemon --watch dist --exec \"node dist/cli.js\"",
		"start": "npm run build && node dist/cli.js",
		"test": "npm run build && prettier --write . && ava",
		"test:ci": "npm run build && prettier --check . && ava",
		"lint": "xo",
		"lint:fix": "xo --fix",
		"quality:check": "npm run lint",
		"release": "release-it"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@inkjs/ui": "^2.0.0",
		"@types/ms": "^2.1.0",
		"@types/node-notifier": "^8.0.5",
		"figures": "^6.1.0",
		"ink": "^6.0.1",
		"ink-big-text": "^2.0.0",
		"ink-gradient": "^3.0.0",
		"meow": "^11.0.0",
		"ms": "^2.1.3",
		"node-notifier": "^10.0.1",
		"open": "^10.1.2",
		"react": "^19.1.0",
		"winston": "^3.17.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.1.8",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^4.0.0",
		"prettier": "^2.8.7",
		"react-devtools-core": "^4.28.5",
		"release-it": "^19.0.4",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.3",
		"xo": "^0.53.1"
	},
	"ava": {
		"files": [
			"dist/**/*.test.js",
			"dist/*.test.js",
			"dist/tests/**/*.test.js"
		]
	},
	"xo": {
		"prettier": true,
		"ignores": [
			"assets/**",
			"dist/**"
		],
		"overrides": [
			{
				"files": [
					"**/*.test.ts",
					"**/*.test.tsx",
					"**/tests/**/*.ts",
					"**/tests/**/*.tsx"
				],
				"rules": {
					"@typescript-eslint/no-empty-function": "off"
				}
			}
		],
		"rules": {
			"max-lines": [
				"error",
				{
					"max": 1800,
					"skipComments": true,
					"skipBlankLines": true
				}
			],
			"@typescript-eslint/restrict-template-expressions": "off",
			"unicorn/expiring-todo-comments": "off",
			"unicorn/filename-case": "off",
			"unicorn/prevent-abbreviations": "off",
			"unicorn/no-empty-file": "off",
			"@typescript-eslint/naming-convention": "off",
			"@typescript-eslint/prefer-nullish-coalescing": "off",
			"@typescript-eslint/no-implicit-any-catch": "off",
			"@typescript-eslint/ban-types": "off",
			"@typescript-eslint/padding-line-between-statements": "off",
			"@typescript-eslint/prefer-regexp-exec": "off",
			"@typescript-eslint/no-extraneous-class": "off",
			"@typescript-eslint/consistent-type-definitions": "off",
			"@typescript-eslint/consistent-type-imports": "off",
			"@typescript-eslint/prefer-readonly": "off",
			"@typescript-eslint/parameter-properties": "off",
			"@typescript-eslint/no-unsafe-assignment": "off",
			"@typescript-eslint/prefer-optional-chain": "off",
			"@typescript-eslint/member-ordering": "off",
			"@typescript-eslint/consistent-indexed-object-style": "off",
			"react/jsx-sort-props": "off",
			"import/order": "off",
			"n/prefer-global/process": "off",
			"ava/no-ignored-test-files": "off",
			"no-await-in-loop": "off",
			"no-negated-condition": "off",
			"prefer-destructuring": "off",
			"capitalized-comments": "off",
			"complexity": "off",
			"@typescript-eslint/no-unsafe-call": "off",
			"import/first": "off",
			"@typescript-eslint/no-unnecessary-type-assertion": "off",
			"@typescript-eslint/no-dynamic-delete": "off",
			"unicorn/numeric-separators-style": "off",
			"no-misleading-character-class": "off",
			"@typescript-eslint/no-base-to-string": "off",
			"@typescript-eslint/consistent-type-assertions": "off",
			"@typescript-eslint/promise-function-async": "off",
			"unicorn/catch-error-name": "off",
			"unicorn/no-lonely-if": "off",
			"unicorn/escape-case": "off",
			"unicorn/no-hex-escape": "off",
			"@typescript-eslint/no-inferrable-types": "off",
			"unicorn/no-new-array": "off",
			"unicorn/explicit-length-check": "off",
			"unicorn/prefer-set-has": "off",
			"ava/no-async-fn-without-await": "off",
			"ava/prefer-t-regex": "off",
			"unicorn/switch-case-braces": "off",
			"@typescript-eslint/prefer-ts-expect-error": "off",
			"@typescript-eslint/ban-ts-comment": "off",
			"@typescript-eslint/restrict-plus-operands": "off",
			"no-eq-null": "off",
			"@typescript-eslint/no-floating-promises": "off",
			"unicorn/prefer-module": "off",
			"max-params": "off",
			"@typescript-eslint/no-require-imports": "off",
			"@typescript-eslint/no-var-requires": "off",
			"n/prefer-global/buffer": "off",
			"new-cap": "off",
			"unicorn/no-await-expression-member": "off",
			"@typescript-eslint/return-await": "off",
			"no-return-await": "off",
			"@typescript-eslint/class-literal-property-style": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config",
	"release-it": {
		"$schema": "https://unpkg.com/release-it/schema/release-it.json",
		"github": {
			"release": true
		}
	}
}
